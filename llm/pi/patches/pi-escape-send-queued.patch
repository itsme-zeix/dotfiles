+
+    /**
+     * Interrupt the active run. When messages are queued, clear them and send
+     * them immediately as a new user turn; with an empty queue this is a plain
+     * interrupt (queued messages restored to the editor, as before).
+     */
+    handleQueuedInterrupt() {
+        const { steering, followUp } = this.getAllQueuedMessages();
+        const queued = [...steering, ...followUp];
+        if (queued.length === 0) {
+            this.restoreQueuedMessagesToEditor({ abort: true });
+            return;
+        }
+        // Clear before aborting so the winding-down run cannot drain the messages
+        // mid-tool-batch and leave them unanswered in context.
+        this.clearAllQueues();
+        this.updatePendingMessagesDisplay();
+        const text = queued.join("\n\n");
+        void (async () => {
+            try {
+                await this.session.abort();
+                await this.session.prompt(text, { expandPromptTemplates: false });
+            }
+            catch (error) {
+                const draft = this.editor.getText();
+                this.editor.setText([text, draft].filter((t) => t.trim()).join("\n\n"));
+                this.showError(`Failed to send queued message${queued.length > 1 ? "s" : ""}: ${error instanceof Error ? error.message : String(error)}`);
+            }
+            this.ui.requestRender();
+        })();
+    }
     updateEditorBorderColor() {
         if (this.isBashMode) {
             this.editor.borderColor = theme.getBashModeBorderColor();
